# AFL++ dictionary for the Binance depth JSON parsers.
# Tokens the mutator splices in verbatim, so it reaches valid structure faster.
snapshot_keys="lastUpdateId"
bids="bids"
asks="asks"
update_bids="b"
update_asks="a"
event_time="E"
first_id="U"
final_id="u"
obj_open="{"
obj_close="}"
arr_open="["
arr_close="]"
quote="\""
colon=":"
comma=","
dot="."
neg="-"
zero="0"
small_num="\"1.5\""
level="[\"100.00\",\"1.0\"]"
