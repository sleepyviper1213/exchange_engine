{
    "version": 6,
    "include": [
        "base.json"
    ],
    "configurePresets": [
        {
            "name": "dev-options",
            "hidden": true,
            "description": "Day-to-day iteration: all three ordinary configurations, precompiled header, ccache.",
            "inherits": "vcpkg-base",
            "cacheVariables": {
                "EXCHANGE_ENABLE_UNITY_BUILD": "OFF",
                "EXCHANGE_ENABLE_PCH": "ON",
                "EXCHANGE_ENABLE_CCACHE": "ON",
                "EXCHANGE_ENABLE_IPO": "ON",
                "EXCHANGE_WARNINGS_AS_ERRORS": "ON",
                "EXCHANGE_WARN_UNSAFE_BUFFERS": "OFF",
                "EXCHANGE_HARDENING": "ON",
                "EXCHANGE_HARDENING_UBSAN_TRAP": "OFF",
                "EXCHANGE_ENABLE_STATIC_ANALYZERS": "OFF",
                "EXCHANGE_ENABLE_COVERAGE": "OFF"
            }
        },
        {
            "name": "safety-options",
            "hidden": true,
            "description": "Debug only, every safety option on. Hardening and trapping UBSan are tree-wide rather than per-configuration, which is why this narrows CMAKE_CONFIGURATION_TYPES instead of sharing a tree with Release.",
            "inherits": "vcpkg-base",
            "cacheVariables": {
                "CMAKE_CONFIGURATION_TYPES": "Debug",
                "EXCHANGE_HARDENING": "debug",
                "EXCHANGE_HARDENING_UBSAN_TRAP": "ON",
                "EXCHANGE_WARN_UNSAFE_BUFFERS": "ON",
                "EXCHANGE_WARNINGS_AS_ERRORS": "ON",
                "EXCHANGE_ENABLE_UNITY_BUILD": "ON",
                "EXCHANGE_ENABLE_CCACHE": "ON",
                "EXCHANGE_ENABLE_IPO": "OFF",
                "EXCHANGE_ENABLE_STATIC_ANALYZERS": "OFF",
                "EXCHANGE_ENABLE_COVERAGE": "OFF"
            }
        },
        {
            "name": "coverage-options",
            "hidden": true,
            "description": "Debug and RelWithDebInfo only - the two configurations enable_coverage instruments.",
            "inherits": "vcpkg-base",
            "cacheVariables": {
                "CMAKE_CONFIGURATION_TYPES": "Debug;RelWithDebInfo",
                "EXCHANGE_ENABLE_COVERAGE": "ON",
                "EXCHANGE_ENABLE_UNITY_BUILD": "OFF",
                "EXCHANGE_ENABLE_PCH": "ON",
                "EXCHANGE_ENABLE_CCACHE": "OFF",
                "EXCHANGE_ENABLE_IPO": "OFF",
                "EXCHANGE_WARNINGS_AS_ERRORS": "ON",
                "EXCHANGE_WARN_UNSAFE_BUFFERS": "OFF",
                "EXCHANGE_HARDENING": "ON"
            }
        },
        {
            "name": "analysis-options",
            "hidden": true,
            "description": "Compile-only static analysis: clang-tidy and cppcheck as compiler launchers, no coverage and no test step. One configuration, because both tools read the same sources in every one. Unity batching and PCH are OFF rather than left to the guards in test/CMakeLists.txt that CMAKE_CXX_CLANG_TIDY trips anyway - a preset claiming PCH it does not get reads as configured and working when it is not.",
            "inherits": "vcpkg-base",
            "cacheVariables": {
                "CMAKE_CONFIGURATION_TYPES": "Debug",
                "EXCHANGE_ENABLE_STATIC_ANALYZERS": "ON",
                "EXCHANGE_ENABLE_COVERAGE": "OFF",
                "EXCHANGE_ENABLE_UNITY_BUILD": "OFF",
                "EXCHANGE_ENABLE_PCH": "OFF",
                "EXCHANGE_ENABLE_CCACHE": "ON",
                "EXCHANGE_ENABLE_IPO": "OFF",
                "EXCHANGE_WARNINGS_AS_ERRORS": "ON",
                "EXCHANGE_WARN_UNSAFE_BUFFERS": "OFF",
                "EXCHANGE_HARDENING": "ON",
                "EXCHANGE_HARDENING_UBSAN_TRAP": "OFF"
            }
        },
        {
            "name": "sanitizer-options",
            "hidden": true,
            "description": "Shared by every sanitizer preset. IPO is off: LTO inlines away the frames a sanitizer report is made of.",
            "inherits": "vcpkg-base",
            "cacheVariables": {
                "EXCHANGE_ENABLE_UNITY_BUILD": "ON",
                "EXCHANGE_ENABLE_CCACHE": "ON",
                "EXCHANGE_ENABLE_IPO": "OFF",
                "EXCHANGE_WARNINGS_AS_ERRORS": "ON",
                "EXCHANGE_WARN_UNSAFE_BUFFERS": "OFF",
                "EXCHANGE_HARDENING": "ON",
                "EXCHANGE_HARDENING_UBSAN_TRAP": "OFF",
                "EXCHANGE_ENABLE_COVERAGE": "OFF",
                "EXCHANGE_ENABLE_STATIC_ANALYZERS": "OFF"
            }
        },
        {
            "name": "asan-options",
            "hidden": true,
            "inherits": "sanitizer-options",
            "cacheVariables": {
                "CMAKE_CONFIGURATION_TYPES": "AddressSanitizer",
                "EXCHANGE_SANITIZER": "Address"
            }
        },
        {
            "name": "tsan-options",
            "hidden": true,
            "inherits": "sanitizer-options",
            "cacheVariables": {
                "CMAKE_CONFIGURATION_TYPES": "ThreadSanitizer",
                "EXCHANGE_SANITIZER": "Thread"
            }
        },
        {
            "name": "ubsan-options",
            "hidden": true,
            "inherits": "sanitizer-options",
            "cacheVariables": {
                "CMAKE_CONFIGURATION_TYPES": "UndefinedSanitizer",
                "EXCHANGE_SANITIZER": "Undefined"
            }
        },
        {
            "name": "lsan-options",
            "hidden": true,
            "inherits": "sanitizer-options",
            "cacheVariables": {
                "CMAKE_CONFIGURATION_TYPES": "LeakSanitizer",
                "EXCHANGE_SANITIZER": "Leak"
            }
        },
        {
            "name": "msan-options",
            "hidden": true,
            "inherits": "sanitizer-options",
            "cacheVariables": {
                "CMAKE_CONFIGURATION_TYPES": "MemorySanitizer",
                "EXCHANGE_SANITIZER": "Memory"
            }
        },
        {
            "name": "hwasan-options",
            "hidden": true,
            "inherits": "sanitizer-options",
            "cacheVariables": {
                "CMAKE_CONFIGURATION_TYPES": "HWAddressSanitizer",
                "EXCHANGE_SANITIZER": "HWAddress"
            }
        }
    ]
}
